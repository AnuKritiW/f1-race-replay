    {
      "id": "N-F6QfyNrGDAkIJt7yAQt",
      "type": "text",
      "x": 1753.6476091493998,
      "y": 1057.7570956226891,
      "width": 394.3333435058594,
      "height": 80,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nioChjq-qLYEYiMda_pJ0"
      ],
      "frameId": null,
      "index": "b1k",
      "roundness": null,
      "seed": 1971827183,
      "version": 610,
      "versionNonce": 1962559951,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773221164067,
      "link": null,
      "locked": false,
      "text": "(1) starts the Ingest Service at the beginning of \n    each session to begin live telemetry ingestion, \n(2) triggers post-race ingestion of the completed \n     session from OpenF1 after the session ends.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(1) starts the Ingest Service at the beginning of \n    each session to begin live telemetry ingestion, \n(2) triggers post-race ingestion of the completed \n     session from OpenF1 after the session ends.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NPKCcNmOkAPOKsUkz4qPM",
      "type": "text",
      "x": 1045.0408302824274,
      "y": 1149.1781908053347,
      "width": 555.7000122070312,
      "height": 100,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1n",
      "roundness": null,
      "seed": 1646106145,
      "version": 372,
      "versionNonce": 496404079,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773220948172,
      "link": null,
      "locked": false,
      "text": "* Note that (2) post-race ingest uses upsert.\nIf live data already exists for that session it is overwritten with the \nfinal cleaned dataset from OpenF1. Prevents duplicates and ensures \nhistorical data is always the official version.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Note that (2) post-race ingest uses upsert.\nIf live data already exists for that session it is overwritten with the \nfinal cleaned dataset from OpenF1. Prevents duplicates and ensures \nhistorical data is always the official version.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
