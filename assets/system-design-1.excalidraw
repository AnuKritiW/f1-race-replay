    {
      "id": "5wjwCWbsdajG0lryN0jtG",
      "type": "text",
      "x": 1356.4493176839396,
      "y": 475.4912702891555,
      "width": 613.566650390625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zr5mYf1I4yixc1wEj20e7"
      ],
      "frameId": null,
      "index": "b1c",
      "roundness": null,
      "seed": 1418187361,
      "version": 182,
      "versionNonce": 696628257,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773222942260,
      "link": null,
      "locked": false,
      "text": "Stores Docker images for the services. A Docker image is a packaged, \nself-contained snapshot of your application code and everything it \nneeds to run. Images are built locally and pushed to ECR on each deployment. \nECS Fargate pulls the latest image from ECR when spinning up or updating \na container. Not involved at runtime — only at deploy time.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stores Docker images for the services. A Docker image is a packaged, \nself-contained snapshot of your application code and everything it \nneeds to run. Images are built locally and pushed to ECR on each deployment. \nECS Fargate pulls the latest image from ECR when spinning up or updating \na container. Not involved at runtime — only at deploy time.",
      "autoResize": true,
      "lineHeight": 1.25
    },
